# From your Supabase project: Project Settings > API.
# Leave these empty to run Datalyze in demo-only mode (no sign-in, sample data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects: use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the publishable key.

# Encrypts connected accounts' API keys. Generate with: openssl rand -base64 32
DATALYZE_SECRET_KEY=

# Claude API key for the AI analyst (console.anthropic.com). Without it the Ask panel says it's switched off.
ANTHROPIC_API_KEY=
